 "briefing": [
  "The bottom number (<b>denominator</b>) says how many equal parts; the top number (<b>numerator</b>) says how many of them you have.",
  "<b>Adding and subtracting:</b> the denominators must be the same. Find a common denominator, change both fractions, then add or subtract the numerators only.",
  "<b>Multiplying:</b> multiply the tops and multiply the bottoms. <b>Dividing:</b> flip the second fraction and multiply.",
  "<b>Mixed numbers</b> such as 2<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">2</span></span> become top-heavy fractions first: <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">2</span></span>. Always simplify your answer."
 ],
 "method": null,
 "examples": [
  {
   "question": "Work out <span class=\"frac\"><span class=\"nu\">2</span><span class=\"de\">3</span></span> + <span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">4</span></span>",
   "steps": [
    "Common denominator 12: <span class=\"frac\"><span class=\"nu\">2</span><span class=\"de\">3</span></span> = <span class=\"frac\"><span class=\"nu\">8</span><span class=\"de\">12</span></span> and <span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">4</span></span> = <span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">12</span></span>.",
    "Add the tops: <span class=\"frac\"><span class=\"nu\">8</span><span class=\"de\">12</span></span> + <span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">12</span></span> = <span class=\"frac\"><span class=\"nu\">11</span><span class=\"de\">12</span></span>."
   ],
   "answer": "<span class=\"frac\"><span class=\"nu\">11</span><span class=\"de\">12</span></span>"
  },
  {
   "question": "Work out <span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">4</span></span> × <span class=\"frac\"><span class=\"nu\">2</span><span class=\"de\">5</span></span>",
   "steps": [
    "Tops: 3 × 2 = 6. Bottoms: 4 × 5 = 20.",
    "<span class=\"frac\"><span class=\"nu\">6</span><span class=\"de\">20</span></span> simplifies to <span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">10</span></span> (÷ 2)."
   ],
   "answer": "<span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">10</span></span>"
  },
  {
   "question": "Work out <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">6</span></span> ÷ <span class=\"frac\"><span class=\"nu\">2</span><span class=\"de\">3</span></span>",
   "steps": [
    "Flip the second fraction and multiply: <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">6</span></span> × <span class=\"frac\"><span class=\"nu\">3</span><span class=\"de\">2</span></span>.",
    "= <span class=\"frac\"><span class=\"nu\">15</span><span class=\"de\">12</span></span> = <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">4</span></span> = 1<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">4</span></span>."
   ],
   "answer": "1<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">4</span></span>"
  },
  {
   "question": "Work out 2<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">2</span></span> + 1<span class=\"frac\"><span class=\"nu\">2</span><span class=\"de\">3</span></span>",
   "steps": [
    "Make them top-heavy: <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">2</span></span> + <span class=\"frac\"><span class=\"nu\">5</span><span class=\"de\">3</span></span>.",
    "Common denominator 6: <span class=\"frac\"><span class=\"nu\">15</span><span class=\"de\">6</span></span> + <span class=\"frac\"><span class=\"nu\">10</span><span class=\"de\">6</span></span> = <span class=\"frac\"><span class=\"nu\">25</span><span class=\"de\">6</span></span>.",
    "<span class=\"frac\"><span class=\"nu\">25</span><span class=\"de\">6</span></span> = 4<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">6</span></span>."
   ],
   "answer": "4<span class=\"frac\"><span class=\"nu\">1</span><span class=\"de\">6</span></span>"
  }
 ],
